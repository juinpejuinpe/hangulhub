rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything lives under the signed-in user's own document tree, so the
    // rule is one line: you can only ever touch your own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default.
  }
}
